# ----------------------
# Server Configuration
# ----------------------
SERVER_PORT=8086

# ----------------------
# AWS RDS Configuration
# ----------------------
DB_HOST=cibf-database.cj4yusc4c0b4.us-west-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cibf_db
DB_SCHEMA=user_schema

SPRING_DATASOURCE_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?currentSchema=${DB_SCHEMA}
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# ----------------------
# Connection Pool
# ----------------------
HIKARI_MAX_POOL_SIZE=5
HIKARI_MIN_IDLE=2

# ----------------------
# JPA Configuration
# ----------------------
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DEFAULT_SCHEMA=user_schema
JPA_CREATE_NAMESPACES=true

# ----------------------
# Logging Configuration
# ----------------------
LOGGING_ROOT_LEVEL=INFO
LOGGING_CIBF_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=DEBUG
LOGGING_WEB_LEVEL=DEBUG
LOGGING_CONTEXT_LEVEL=DEBUG

# ----------------------
# Error Messages (Development Only)
# ----------------------
ERROR_INCLUDE_MESSAGE=always
ERROR_INCLUDE_BINDING_ERRORS=always
ERROR_INCLUDE_STACKTRACE=on_param
ERROR_INCLUDE_EXCEPTION=true

# ----------------------
# JWT Configuration
# ----------------------
JWT_SECRET=JE6WwDKZ8uMOOwt+XnkQTPvb2sj0BD58Kc1WwxTHfVaB7otOwANuKKhbGPvKjA6hDyo0y7qls24Irt6rHLINEA==
JWT_EXPIRATION=86400000  # 24 hours

# ----------------------
# Health Check
# ----------------------
MANAGEMENT_WEB_EXPOSURE=health,info
AWS_REGION=us-west-2